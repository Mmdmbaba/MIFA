generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// تراکنش مالی — مبلغ به تومان (عدد صحیح)
model Transaction {
  id        String   @id @default(cuid())
  type      String   // "expense" | "income"
  amount    Int      // تومان
  title     String?  // یادداشت اختیاری
  category  String   // شناسه دسته: groceries, transport, ...
  date      DateTime // تاریخ تراکنش
  source    String   @default("manual") // "manual" | "sms"
  createdAt DateTime @default(now())

  @@index([date])
  @@index([category])
}

// پروفایل کاربر — حاصل onboarding اولین ورود
model Profile {
  id            String   @id @default("me")
  name          String   // اسم کاربر
  income        Int      // درآمد ماهانه (تومان)
  payday        Int      @default(1) // روز واریز حقوق در ماه جلالی (۱-۳۱)
  cycleStartDay Int      @default(1) // روز شروع دوره مالی در تقویم جلالی (۱-۳۱)
  savingsMode   String   @default("auto") // "auto" | "amount" | "percent" | "none"
  savingsAmount Int      @default(0) // مبلغ مشخص پس‌انداز (تومان)
  savingsPercent Int     @default(20) // درصد پس‌انداز
  onboardedAt   DateTime @default(now())
}

// هزینه ثابت ماهانه — اجاره، قسط، قبض‌ها، اشتراک‌ها و ...
model FixedExpense {
  id        String   @id @default(cuid())
  label     String   // عنوان فارسی
  amount    Int      // تومان
  icon      String   @default("bills") // شناسه دسته برای آیکون/رنگ
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// بودجه ماهانه کل — کلید ماه جلالی مثل "1404-09"
model Budget {
  id        String @id @default(cuid())
  month     String @unique // "1404-09"
  amount    Int    // تومان
}

// بودجه هر دسته در یک ماه
model CategoryBudget {
  id       String @id @default(cuid())
  month    String
  category String
  amount   Int    // تومان

  @@unique([month, category])
}
